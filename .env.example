DJANGO_DEBUG=true
# Gere uma chave: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ORIGINS=

# local = cadastro deste sistema (e XML, se usar)
# externa = só o banco da empresa
# auto = tenta o banco da empresa e, se não achar, usa o cadastro local
NOTAS_ORIGEM=local

